<script>
  (function(){
    var toggle = document.getElementById('menuToggle');
    var menu = document.getElementById('mobileMenu');
    if(!toggle || !menu) return;

    function closeMenu(){
      menu.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded','false');
      document.body.classList.remove('menu-open');
    }

    toggle.addEventListener('click', function(){
      var isOpen = menu.classList.toggle('open');
      toggle.classList.toggle('open', isOpen);
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      document.body.classList.toggle('menu-open', isOpen);
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({ event: 'menu_toggle', menu_action: isOpen ? 'open' : 'close' });
    });

    menu.querySelectorAll('a').forEach(function(link){
      link.addEventListener('click', closeMenu);
    });
  })();
</script>

<script>
  (function(){
    // --------------------------------------------------------------
    // Cole aqui a sua chave de acesso do Web3Forms (web3forms.com).
    // Sem ela, o formulário mostra um aviso e não envia nada.
    // --------------------------------------------------------------
    var WEB3FORMS_ACCESS_KEY = '8396b81e-8425-4158-b713-f147ddb9eadc';

    var overlay = document.getElementById('diagModalOverlay');
    var closeBtn = document.getElementById('diagModalClose');
    var formIntro = document.getElementById('diagFormIntro');
    var form = document.getElementById('diagForm');
    var submitBtn = document.getElementById('diagSubmitBtn');
    var errorEl = document.getElementById('diagFormError');
    var successEl = document.getElementById('diagSuccess');
    var successCloseBtn = document.getElementById('diagSuccessClose');
    var lastFocused = null;

    if(!overlay || !form) return;

    var accessKeyField = form.querySelector('input[name="access_key"]');
    if(accessKeyField) accessKeyField.value = WEB3FORMS_ACCESS_KEY;

    function openModal(){
      lastFocused = document.activeElement;
      overlay.hidden = false;
      document.body.classList.add('modal-open');
      var firstField = form.querySelector('#diagNome');
      if(firstField) firstField.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closeModal(){
      overlay.hidden = true;
      document.body.classList.remove('modal-open');
      document.removeEventListener('keydown', onKeydown);
      if(lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    function onKeydown(e){
      if(e.key === 'Escape') closeModal();
    }

    document.querySelectorAll('.js-open-diagnostico').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault();
        errorEl.hidden = true;
        if(formIntro) formIntro.hidden = false;
        form.hidden = false;
        successEl.hidden = true;
        openModal();

        window.dataLayer = window.dataLayer || [];
        dataLayer.push({
          event: 'cta_click',
          cta_location: btn.dataset.ctaLocation || 'unknown',
          cta_text: btn.textContent.trim()
        });
      });
    });

    // CTA secundária do hero ("Ver como funciona") não abre o modal,
    // só rola até o Método — rastreada à parte.
    var heroSecondary = document.querySelector('[data-cta-location="hero_secondary"]');
    if(heroSecondary){
      heroSecondary.addEventListener('click', function(){
        window.dataLayer = window.dataLayer || [];
        dataLayer.push({
          event: 'cta_click',
          cta_location: 'hero_secondary',
          cta_text: heroSecondary.textContent.trim()
        });
      });
    }

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function(e){
      if(e.target === overlay) closeModal();
    });
    if(successCloseBtn) successCloseBtn.addEventListener('click', closeModal);

    // form_start: dispara uma única vez, no primeiro campo preenchido.
    var formStarted = false;
    form.addEventListener('input', function(){
      if(formStarted) return;
      formStarted = true;
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({ event: 'form_start', form_id: 'diagnostico' });
    });

    form.addEventListener('submit', function(e){
      e.preventDefault();
      errorEl.hidden = true;

      if(!WEB3FORMS_ACCESS_KEY || WEB3FORMS_ACCESS_KEY.indexOf('COLOQUE_') === 0){
        errorEl.textContent = 'Formulário ainda não configurado: falta colocar a chave de acesso do Web3Forms no código.';
        errorEl.hidden = false;
        return;
      }

      var siteField = form.querySelector('#diagSite');
      if(siteField && siteField.value && !/^https?:\/\//i.test(siteField.value.trim())){
        siteField.value = 'https://' + siteField.value.trim();
      }

      var data = new FormData(form);
      var payload = {};
      data.forEach(function(value, key){ payload[key] = value; });

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function(res){ return res.json(); })
        .then(function(result){
          window.dataLayer = window.dataLayer || [];
          if(result.success){
            form.reset();
            if(formIntro) formIntro.hidden = true;
            form.hidden = true;
            successEl.hidden = false;
            // Evento recomendado do GA4 para geração de lead.
            dataLayer.push({
              event: 'generate_lead',
              form_id: 'diagnostico',
              lead_source: 'diagnostico_form'
            });
          } else {
            errorEl.textContent = 'Não consegui enviar agora. Tenta de novo ou escreve pra contato@ganica.com.br.';
            errorEl.hidden = false;
            dataLayer.push({ event: 'form_error', form_id: 'diagnostico', error_reason: 'api_response' });
          }
        })
        .catch(function(){
          errorEl.textContent = 'Não consegui enviar agora. Tenta de novo ou escreve pra contato@ganica.com.br.';
          errorEl.hidden = false;
          window.dataLayer = window.dataLayer || [];
          dataLayer.push({ event: 'form_error', form_id: 'diagnostico', error_reason: 'network' });
        })
        .finally(function(){
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar diagnóstico';
        });
    });
  })();
</script>
<script>
  // ------------------------------------------------------------
  // Profundidade de conteúdo: dispara uma vez por seção quando
  // ela entra na tela — dá visão de até onde o usuário rola.
  // ------------------------------------------------------------
  (function(){
    window.dataLayer = window.dataLayer || [];
    var sectionIds = ['diferenciais', 'metodo', 'estudo', 'diagnostico', 'principios', 'sobre'];
    if(!('IntersectionObserver' in window)) return;

    var observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          dataLayer.push({ event: 'section_view', section_name: entry.target.id });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });

    sectionIds.forEach(function(id){
      var el = document.getElementById(id);
      if(el) observer.observe(el);
    });
  })();

  // ------------------------------------------------------------
  // Engajamento com o scroll horizontal do Método (mobile).
  // Dispara uma vez, na primeira rolagem perceptível.
  // ------------------------------------------------------------
  (function(){
    var track = document.querySelector('.metodo-track');
    if(!track) return;
    var fired = false;
    track.addEventListener('scroll', function(){
      if(fired || track.scrollLeft < 20) return;
      fired = true;
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({ event: 'select_content', content_type: 'metodo_scroll' });
    });
  })();
</script>
<script>
  document.querySelectorAll('.js-track-click').forEach(function(el){
    el.addEventListener('click', function(){
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({
        event: 'cta_click',
        cta_location: el.dataset.ctaLocation || 'unknown',
        cta_text: el.textContent.trim()
      });
    });
  });
</script>
