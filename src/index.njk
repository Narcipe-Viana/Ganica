<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">

<!-- ==========================================================
     GOOGLE TAG MANAGER / GA4: DATA LAYER
     O dataLayer precisa existir antes do snippet do GTM.
     Cole o snippet oficial do GTM (com o seu GTM-XXXXXXX) logo
     abaixo desta inicialização, e o snippet <noscript> do GTM
     logo após a tag <body> (marcado mais abaixo no arquivo).
     ========================================================== -->
<script>
  window.dataLayer = window.dataLayer || [];
  dataLayer.push({
    event: 'page_data',
    page_type: 'landing_page',
    page_language: 'pt-BR',
    business_unit: 'ganica_cro'
  });
</script>
<!-- TODO: Colar aqui o snippet padrão do Google Tag Manager -->

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Consultoria de CRO para e-commerce | Ganica</title>
<meta name="description" content="Consultoria independente de CRO para e-commerce: diagnóstico, priorização e execução guiadas por dados, com escopo e prazo fechados. Sem retainer.">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<meta name="author" content="{{ site.autor }}">
<link rel="canonical" href="{{ site.url }}/">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.nome }}">
<meta property="og:title" content="Consultoria de CRO para e-commerce | Ganica">
<meta property="og:description" content="Diagnóstico, priorização e execução guiadas por dados, com escopo e prazo fechados. Consultoria independente de CRO para e-commerce.">
<meta property="og:url" content="{{ site.url }}/">
<meta property="og:locale" content="pt_BR">
<meta property="og:image" content="{{ site.url }}/assets/og/ganica.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Ganica, consultoria de CRO para e-commerce">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Consultoria de CRO para e-commerce | Ganica">
<meta name="twitter:description" content="Diagnóstico, priorização e execução guiadas por dados, com escopo e prazo fechados.">
<meta name="twitter:image" content="{{ site.url }}/assets/og/ganica.png">
{% include "partials/head-comum.njk" %}

<!-- ==========================================================
     SCHEMA.ORG (JSON-LD): FAQPage e HowTo não geram mais rich
     results (removidos em 2026), por isso não são usados aqui.
     O maior ganho é estabelecer a entidade (Organization/Person)
     de forma verificável, sinal de confiança em resultados de IA.
     ========================================================== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "{{ site.url }}/#organization",
      "logo": { "@type": "ImageObject", "url": "{{ site.url }}/logo-ganica.png", "width": 512, "height": 512 },
      "image": "{{ site.url }}/assets/og/ganica.png",
      "name": "{{ site.nome }}",
      "url": "{{ site.url }}/",
      "description": {{ site.orgDescricao | json | safe }},
      "email": "{{ site.email }}",
      "areaServed": { "@type": "Country", "name": "Brasil" },
      "knowsAbout": ["CRO", "Otimização de Conversão", "E-commerce", "Google Analytics 4", "Google Tag Manager", "UX", "Análise comportamental"],
      "founder": { "@id": "{{ site.url }}/#narcipe-viana" }
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#narcipe-viana",
      "name": "{{ site.autor }}",
      "jobTitle": "{{ site.autorCargo }}",
      "url": "{{ site.url }}/#sobre",
      "image": "{{ site.url }}/assets/img/narcipe-viana.jpg",
      "worksFor": { "@id": "{{ site.url }}/#organization" },
      "knowsAbout": ["CRO", "Otimização de Conversão", "E-commerce"]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "{{ site.nome }}",
      "inLanguage": "pt-BR",
      "publisher": { "@id": "{{ site.url }}/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": "{{ site.url }}/#webpage",
      "url": "{{ site.url }}/",
      "name": "Consultoria de CRO para e-commerce | Ganica",
      "description": "Consultoria independente de CRO para e-commerce: diagnóstico, priorização e execução guiadas por dados, com escopo e prazo fechados.",
      "inLanguage": "pt-BR",
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "about": { "@id": "{{ site.url }}/#organization" },
      "mainEntity": { "@id": "{{ site.url }}/#diagnostico" },
      "primaryImageOfPage": { "@type": "ImageObject", "url": "{{ site.url }}/assets/og/ganica.png", "width": 1200, "height": 630 }{% if ultimo %},
      "dateModified": "{{ (ultimo.data.updated or ultimo.data.date) | dataISO }}"{% endif %}
    },
    {
      "@type": "Service",
      "@id": "{{ site.url }}/#diagnostico",
      "name": "Diagnóstico de Conversão",
      "url": "{{ site.url }}/#diagnostico",
      "serviceType": "Consultoria de CRO",
      "description": "Diagnóstico fechado que mapeia oportunidades de conversão em e-commerce: verificação de tracking, auditoria de UX e priorização por impacto na receita.",
      "provider": { "@id": "{{ site.url }}/#organization" },
      "areaServed": { "@type": "Country", "name": "Brasil" }
    }
  ]
}
</script>
