<!-- ==========================================================
     GOOGLE TAG MANAGER / GA4 — DATA LAYER
     O dataLayer precisa existir antes do snippet do GTM.
     Cole o snippet oficial do GTM (com o seu GTM-XXXXXXX) logo
     abaixo desta inicialização — e o snippet <noscript> do GTM
     logo após a tag <body> (marcado mais abaixo no arquivo).
     ========================================================== -->
<script>
  window.dataLayer = window.dataLayer || [];
  dataLayer.push({
    event: 'page_data',
    page_type: 'landing_page',
    page_language: 'pt-BR',
    business_unit: 'ganica_cro'
  });
</script>
<!-- TODO: Colar aqui o snippet padrão do Google Tag Manager -->

