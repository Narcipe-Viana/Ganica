<link rel="apple-touch-icon" href="/favicon.svg">

<!-- ==========================================================
     SCHEMA.ORG (JSON-LD) — recomendações de 2026:
     FAQPage e HowTo não geram mais rich results (removidos em
     2026), por isso não foram usados aqui. O maior ganho hoje
     é estabelecer a entidade (Organization/Person) de forma
     verificável, que é o que o Google usa como sinal de
     confiança em resultados de IA (AI Mode / AI Overviews).
     ========================================================== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://ganica.com.br/#organization",
      "logo": { "@type": "ImageObject", "url": "https://ganica.com.br/logo-ganica.png", "width": 512, "height": 512 },
      "name": "Ganica",
      "url": "https://ganica.com.br/",
      "description": "Consultoria independente de CRO (otimização de conversão) para e-commerce, com projetos de escopo e prazo fechados.",
      "email": "contato@ganica.com.br",
      "areaServed": { "@type": "Country", "name": "Brasil" },
      "knowsAbout": ["CRO", "Otimização de Conversão", "E-commerce", "Google Analytics 4", "Google Tag Manager", "UX", "Análise comportamental"],
      "founder": { "@id": "https://ganica.com.br/#narcipe-viana" }
    },
    {
      "@type": "Person",
      "@id": "https://ganica.com.br/#narcipe-viana",
      "name": "Narcipe Viana",
      "jobTitle": "Consultor de CRO",
      "worksFor": { "@id": "https://ganica.com.br/#organization" },
      "knowsAbout": ["CRO", "Otimização de Conversão", "E-commerce"]
    },
    {
      "@type": "WebSite",
      "@id": "https://ganica.com.br/#website",
      "url": "https://ganica.com.br/",
      "name": "Ganica",
      "inLanguage": "pt-BR",
      "publisher": { "@id": "https://ganica.com.br/#organization" }
    },
    {
      "@type": "Service",
      "@id": "https://ganica.com.br/#diagnostico",
      "name": "Diagnóstico de Conversão",
      "serviceType": "Consultoria de CRO",
      "description": "Diagnóstico fechado que mapeia oportunidades de conversão em e-commerce: verificação de tracking, auditoria de UX e priorização por impacto na receita.",
      "provider": { "@id": "https://ganica.com.br/#organization" },
      "areaServed": { "@type": "Country", "name": "Brasil" }
    }
  ]
}
</script>
