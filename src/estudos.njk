---
permalink: /estudos/index.html
---
{%- set total = collections.estudos | length -%}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<script>
  window.dataLayer = window.dataLayer || [];
  dataLayer.push({ event: 'page_data', page_type: 'listing', content_group: 'estudo', page_language: 'pt-BR', business_unit: 'ganica_cro' });
</script>
<!-- TODO: Colar aqui o snippet padrão do Google Tag Manager -->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Biblioteca de estudos de CRO para e-commerce | Ganica</title>
<meta name="description" content="Biblioteca de estudos da Ganica sobre CRO e e-commerce: dado de mercado, heatmap real e funil de conversão analisados com rigor, sem achismo. Leitura gratuita.">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<link rel="canonical" href="{{ site.url }}/estudos/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.nome }}">
<meta property="og:title" content="Estudos exclusivos de CRO para e-commerce">
<meta property="og:description" content="Levantamentos próprios da Ganica sobre CRO e e-commerce: dado de mercado, heatmap real e funil de conversão.">
<meta property="og:url" content="{{ site.url }}/estudos/">
<meta property="og:locale" content="pt_BR">
<meta property="og:image" content="{{ site.url }}/assets/og/estudos.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Biblioteca de estudos de CRO da Ganica">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Estudos exclusivos de CRO para e-commerce">
<meta name="twitter:description" content="Levantamentos próprios da Ganica sobre CRO e e-commerce: dado de mercado, heatmap real e funil de conversão.">
<meta name="twitter:image" content="{{ site.url }}/assets/og/estudos.png">
{% include "partials/head-comum.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "{{ site.url }}/#organization",
      "name": "{{ site.nome }}",
      "url": "{{ site.url }}/",
      "logo": { "@type": "ImageObject", "url": "{{ site.url }}/logo-ganica.png", "width": 512, "height": 512 },
      "email": "{{ site.email }}",
      "founder": { "@id": "{{ site.url }}/#narcipe-viana" }
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#narcipe-viana",
      "name": "{{ site.autor }}",
      "jobTitle": "{{ site.autorCargo }}",
      "url": "{{ site.url }}/#sobre",
      "image": "{{ site.url }}/assets/img/narcipe-viana.jpg",
      "worksFor": { "@id": "{{ site.url }}/#organization" }
    },
    {
      "@type": ["CollectionPage", "Blog"],
      "@id": "{{ site.url }}/estudos/#page",
      "url": "{{ site.url }}/estudos/",
      "name": "Estudos exclusivos de CRO",
      "headline": "Estudos exclusivos de CRO para e-commerce",
      "description": "Levantamentos próprios da Ganica sobre CRO e e-commerce: dado de mercado, heatmap real e funil de conversão analisados com rigor.",
      "inLanguage": "pt-BR",
      "image": "{{ site.url }}/assets/og/estudos.png",
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "publisher": { "@id": "{{ site.url }}/#organization" },
      "author": { "@id": "{{ site.url }}/#narcipe-viana" },
      {%- if collections.estudos.length %}
      "dateModified": "{{ (collections.estudos[0].data.updated or collections.estudos[0].data.date) | dataISO }}",
      {%- endif %}
      "breadcrumb": { "@id": "{{ site.url }}/estudos/#breadcrumb" },
      "mainEntity": {
        "@type": "ItemList",
        "itemListOrder": "https://schema.org/ItemListOrderDescending",
        "numberOfItems": {{ total }},
        "itemListElement": [{% for e in collections.estudos %}
          {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "url": "{{ site.url }}{{ e.url }}",
            "item": {
              "@type": "BlogPosting",
              "@id": "{{ site.url }}{{ e.url }}#article",
              "headline": {{ e.data.title | json | safe }},
              "description": {{ e.data.description | json | safe }},
              "url": "{{ site.url }}{{ e.url }}",
              "datePublished": "{{ e.data.date | dataISO }}",
              "dateModified": "{{ (e.data.updated or e.data.date) | dataISO }}",
              "image": "{{ site.url }}{{ e.data.imagem_og or ('/assets/og/' + e.data.slug + '.png') }}",
              "author": { "@id": "{{ site.url }}/#narcipe-viana" }
            }
          }{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ site.url }}/estudos/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Início", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Estudos", "item": "{{ site.url }}/estudos/" }
      ]
    }
  ]
}
</script>
<style>
{% include "css/base.css" %}
{% include "css/artigo.css" %}
{% include "css/estudos.css" %}
  .estudos-index{ padding:12px 0 72px; background:var(--panel); }
  .estudos-index .wrap{ padding-inline:12px; padding-top:36px; }
  @media (min-width:900px){
    .estudos-index .wrap{ padding-inline:var(--gutter); padding-top:56px; }
    .estudos-index{ padding-bottom:104px; }
  }
</style>
</head>
<body>
<!-- TODO: Colar aqui o snippet <noscript> padrão do Google Tag Manager -->

{% set ancora = "/" %}{% set origem = "estudos_" %}
{% include "partials/header.njk" %}

<main id="conteudo">
<section class="article-hero com-trama">
  <div class="wrap">
    <nav aria-label="Trilha de navegação"><p class="breadcrumb"><a href="/">Início</a><span class="sep">/</span>Estudos</p></nav>
    <p class="biblioteca-selo"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 5.5C8.5 4.2 6.2 3.7 3 3.8v11.4c3.2-.1 5.5.4 7 1.7 1.5-1.3 3.8-1.8 7-1.7V3.8c-3.2-.1-5.5.4-7 1.7zM10 5.5v11.4"/></svg>Biblioteca de estudos</p>
    <h1>Estudos exclusivos de CRO</h1>
    <p class="article-deck">Conteúdo próprio e gratuito sobre <span class="nw">e-commerce</span> e CRO: dado de mercado, heatmap real e funil de conversão, lidos com o mesmo rigor de um diagnóstico.</p>
    <div class="article-meta"><span>{{ total }} {{ "estudo publicado" if total == 1 else "estudos publicados" }}</span></div>
  </div>
</section>

<section class="estudos-index" aria-label="Lista de estudos">
  <div class="wrap">
    <ol class="biblioteca-lista">
      {%- for e in collections.estudos %}
      <li>{% set tag = "h2" %}{% set local = "estudos_index" %}{% include "partials/card-estudo.njk" %}</li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section id="contato" class="cta-final">
  <div class="wrap">
    <h2>Quer essa leitura aplicada à sua loja?</h2>
    <p>Os estudos mostram padrões. Um diagnóstico mostra onde eles aparecem, e com que intensidade, na sua operação, com os seus próprios dados.</p>
    <div class="hero-ctas">
      <a href="/#contato" class="btn btn-ambar js-track-click" data-cta-location="estudos_cta_final">Solicitar diagnóstico</a>
      <a href="/#diagnostico" class="btn btn-leve js-track-click" data-cta-location="estudos_cta_final_secondary">Ver como funciona</a>
    </div>
  </div>
</section>
</main>

{% include "partials/footer.njk" %}
{% include "partials/scripts-artigo.njk" %}
</body>
</html>
